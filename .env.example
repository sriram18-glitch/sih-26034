# Supabase (primary production DB) — server-side only, never expose SERVICE_ROLE to frontend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SQLAlchemy DB URL (Supabase Postgres). Fallback to local sqlite if empty.
DATABASE_URL=
# Auth
JWT_SECRET=
OFFICER_EMAIL=officer@gov.in
ADMIN_EMAIL=admin@gov.in
# AI / Vision providers (server-side only)
VISION_PROVIDER=demo
# VISION_PROVIDER=tesseract  (requires Tesseract-OCR binary; see TESSERACT_CMD)
TESSERACT_CMD=
# System OCR confidence thresholds (configurable; NOT legal thresholds):
# >= HIGH → auto-usable; < HIGH → human review; < MED → UNREADABLE
OCR_HIGH_CONF=0.75
OCR_MED_CONF=0.45
AI_PROVIDER_API_KEY=
OCR_PROVIDER=tesseract
# Storage
STORAGE_BACKEND=local
INSPECTION_IMAGE_DIR=./data/images
MAX_UPLOAD_MB=10
# CORS
FRONTEND_ORIGIN=http://localhost:5173
# Demo
DEMO_MODE=true
